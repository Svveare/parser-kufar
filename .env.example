# Скопируйте в .env и заполните значения

TOKEN=your_telegram_bot_token
ADMIN_IDS=123456789

# База (пусто = авто: data/bot.db или /app/data/bot.db на BotHost)
# DB_PATH=/app/data/bot.db

# Интервалы опроса, секунды
# CHECK_INTERVAL — тик цикла (не длиннее VIP). VIP ~30с, обычные ~7 мин.
CHECK_INTERVAL=10
VIP_CHECK_INTERVAL=30
REGULAR_CHECK_INTERVAL=420

# TTL кэша fetch: Kufar по ключу + снимок Avito JSON feed (сек).
# По умолчанию max(VIP_CHECK_INTERVAL, 60) — VIP шлёт чаще, HTTP реже.
# FEED_REFRESH_SECONDS=60

# Retention цен для средней рыночной (дней)
PRICE_DATA_RETENTION_DAYS=14

# Kufar
KUFAR_SIZE=40
KUFAR_MAX_PAGES=2
MARKET_DISCOUNT_THRESHOLD=0.85

# VIP «Идеальные (бета)»: минимальный явный % АКБ в описании
IDEAL_MIN_BATTERY_PERCENT=75
# IDEAL_ALLOWED_CONDITIONS=Отличное,Хорошее

# Avito (Россия) — AVITO_ENABLED=true достаточно для live fetch
AVITO_ENABLED=true
# MAX_PRICE_PRESETS_RUB=5000,10000,15000,20000,25000,30000,40000,50000
# DEFAULT_MAX_PRICE_RUB=25000
# AVITO_DEV_MOCK=true
# AVITO_LIVE_ENABLED=false
# AVITO_SEARCH_URL=https://collector.example/avito/search
# AVITO_FEED_URL=https://partner.example/avito-feed.json

# Retention просмотренных объявлений (дней)
SEEN_ADS_RETENTION_DAYS=90

# RollyPay VIP (автовыдача после оплаты)
# ROLLYPAY_ENABLED=true
# ROLLYPAY_API_KEY=
# ROLLYPAY_SIGNING_SECRET=
# ROLLYPAY_TERMINAL_ID=dd737481-bbfd-46a9-992c-feb99069bb23
# PUBLIC_BASE_URL=https://your-bot.bothost.ru
# PORT=8080
# WEBHOOK_HOST=0.0.0.0
# VIP_PAYMENT_POLL_SECONDS=45
# Фикс. суммы в RUB (иначе курс RUB/USDT × $):
# VIP_PRICE_RUB_7=
# VIP_PRICE_RUB_30=
# VIP_PRICE_RUB_90=

# Логи: INFO | DEBUG
LOG_LEVEL=INFO

# SQLITE_SYNCHRONOUS=NORMAL
# REFERRAL_VIP_DAYS_PER_FRIEND=1
